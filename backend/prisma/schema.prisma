// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PerfilUsuario {
  // Pode fazer tudo dentro da própria conta: gerencia usuários, plano e os
  // treinos de qualquer usuário da conta.
  ADMINISTRADOR
  // Gerencia treinos, exercícios e estatísticas de qualquer usuário da
  // própria conta, mas não gerencia usuários nem plano.
  TREINADOR
  // Gerencia apenas os próprios treinos, exercícios e estatísticas.
  ALUNO
}

// Quantidade máxima de usuários por perfil em cada plano fica em
// src/modules/contas/regras/limites-plano.ts.
enum PlanoConta {
  BASICO
  BETA
}

// ---------------------------------------------------------------------------
// Conta (assinante do SaaS) e plano
// ---------------------------------------------------------------------------

model Conta {
  id           Int        @id @default(autoincrement())
  plano        PlanoConta @default(BASICO)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  usuarios Usuario[]

  @@map("contas")
}

// ---------------------------------------------------------------------------
// Autenticação e acesso
// ---------------------------------------------------------------------------

model Usuario {
  id           Int           @id @default(autoincrement())
  contaId      Int           @map("conta_id")
  // O usuário não existe fora da conta — some junto com ela.
  conta        Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  nome         String
  // Único no sistema todo (não só na conta): o login é feito só por email.
  email        String        @unique
  senhaHash    String        @map("senha_hash")
  perfil       PerfilUsuario @default(ALUNO)
  ativo        Boolean       @default(true)
  // Administrador que criou a conta (POST /conta). Não pode ser removido,
  // desativado nem ter o perfil alterado (UsuariosService), para a conta
  // nunca ficar sem administrador.
  proprietario Boolean       @default(false)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  treinos                Treino[]
  codigoRecuperacaoSenha CodigoRecuperacaoSenha?

  @@index([contaId, perfil])
  @@map("usuarios")
}

// Código de 6 dígitos enviado por email para redefinir a senha (fluxo
// "esqueci minha senha"). Só o hash é guardado, nunca o código. Um único
// código ativo por usuário: pedir outro substitui o anterior. É apagado ao
// redefinir a senha; expiração e limite de tentativas ficam em
// RecuperacaoSenhaService.
model CodigoRecuperacaoSenha {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @unique @map("usuario_id")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String   @map("codigo_hash")
  expiraEm   DateTime @map("expira_em")
  // Tentativas erradas de informar o código; trava o código ao atingir o
  // limite, para impedir adivinhar os 6 dígitos.
  tentativas Int      @default(0)
  // Reiniciado a cada novo código; base do intervalo mínimo entre envios.
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("codigos_recuperacao_senha")
}

// ---------------------------------------------------------------------------
// Treinos, exercícios e evolução de carga
// ---------------------------------------------------------------------------

model Treino {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  // O treino não tem sentido sem o dono — some junto com ele.
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo       String
  descricao    String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  exercicios Exercicio[]

  @@index([usuarioId])
  @@map("treinos")
}

// Catálogo de cargas em kg inteiros (1 a 1500), compartilhado por todas as
// contas. Populado pela migration "cargas_compartilhadas"; a faixa fica em
// src/shared/constantes/limites-carga.ts. Não pode ser removida enquanto
// estiver em uso (onDelete Restrict).
model Carga {
  id    Int @id @default(autoincrement())
  valor Int @unique

  exercicios      Exercicio[]
  historicoCargas HistoricoCarga[]

  @@map("cargas")
}

model Exercicio {
  id           Int      @id @default(autoincrement())
  treinoId     Int      @map("treino_id")
  treino       Treino   @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  nome         String
  // Carga atual (catálogo compartilhado). Cada carga nova também é gravada
  // em HistoricoCarga, que é a fonte das estatísticas de evolução de força.
  cargaId      Int      @map("carga_id")
  carga        Carga    @relation(fields: [cargaId], references: [id])
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  historicoCargas HistoricoCarga[]
  series          Serie[]

  @@index([treinoId])
  @@map("exercicios")
}

// Séries de um exercício, cada uma com a sua quantidade de repetições (ex.:
// 12, 10 e 8). A numeração "Série 1, 2, 3" é a ordem de criação (id), sem
// coluna de ordem. Faixa de repetições em
// src/shared/constantes/limites-serie.ts.
model Serie {
  id           Int       @id @default(autoincrement())
  exercicioId  Int       @map("exercicio_id")
  exercicio    Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  repeticoes   Int
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  @@index([exercicioId])
  @@map("series")
}

// Registro imutável de cada carga assumida pelo exercício: um na criação e
// um a cada alteração de carga (ExerciciosService).
model HistoricoCarga {
  id           Int       @id @default(autoincrement())
  exercicioId  Int       @map("exercicio_id")
  exercicio    Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  cargaId      Int       @map("carga_id")
  carga        Carga     @relation(fields: [cargaId], references: [id])
  registradoEm DateTime  @default(now()) @map("registrado_em")

  @@index([exercicioId, registradoEm])
  @@map("historico_cargas")
}
