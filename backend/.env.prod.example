# Ambiente do container no servidor (docker compose). Copie para .env.prod e
# preencha; esse arquivo não vai para o git nem para a imagem.

# Banco de TESTES no servidor. Se o Postgres roda no próprio servidor (fora do
# docker), use host.docker.internal como host. Se exigir SSL, acrescente
# ?sslmode=require.
DATABASE_URL="postgresql://usuario:senha@host.docker.internal:5432/db_wayoftheweights_test?schema=public"

# Segredo dos tokens JWT: gere um valor forte e exclusivo deste ambiente.
JWT_SECRET="troque-por-um-segredo-forte"

# Modo de execução. Em produção o cookie do token vai com secure (só HTTPS).
NODE_ENV="production"

# Enquanto o servidor responder em HTTP puro (sem HTTPS), o cookie secure não é
# guardado e o login não persiste: use COOKIE_SECURE=false. Com HTTPS, remova
# esta linha (o cookie volta a ser secure). Em HTTP, senha e token trafegam sem
# criptografia: coloque HTTPS na frente da API assim que possível.
COOKIE_SECURE=false

# Origens do frontend autorizadas no CORS, separadas por vírgula.
ORIGIN_CLIENT="http://localhost:5173"

# SMTP do código de recuperação de senha.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="Way Of The Weights <seu-email@gmail.com>"

# Leitura de imagens (OCR) com Gemini.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MODEL_CONTINGENCIA="gemini-2.5-flash"

# A porta da API não é definida aqui: use a variável PORTA do compose
# (padrão 3001), ex.: PORTA=3002 docker compose up -d. UPLOADS_DIR também é
# definido pelo compose (/app/uploads).
