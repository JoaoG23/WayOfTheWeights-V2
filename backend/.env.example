# Copie este arquivo para .env e preencha com as credenciais do seu Postgres local.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/db_wayoftheweights_v2?schema=public"

# Segredo usado para assinar os tokens JWT. Gere um valor forte e único,
# nunca reutilize o mesmo segredo entre ambientes.
JWT_SECRET="exercicios-e-treinos-sao-as-chaves-da-vida"

# Porta HTTP da API (padrão 3000).
PORT=3000

# "production" ativa o cookie do token com secure (só HTTPS) e sameSite=strict.
NODE_ENV="development"

# Origens do frontend autorizadas no CORS (com envio de cookie), separadas
# por vírgula.
ORIGIN_CLIENT="http://localhost:5173"

# Servidor SMTP usado para enviar o código de recuperação de senha.
# Gmail: use smtp.gmail.com, porta 587 e uma "senha de app" (não a senha da conta).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# true apenas para a porta 465 (TLS direto); nas demais usa STARTTLS.
SMTP_SECURE=false
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
# Remetente exibido no email (padrão: SMTP_USER).
SMTP_FROM="Way Of The Weights <seu-email@gmail.com>"
