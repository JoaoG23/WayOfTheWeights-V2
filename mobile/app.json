{
  "expo": {
    "name": "Way Of The Weights",
    "slug": "wayoftheweights",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#DCFC34"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joaog.wayoftheweights",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#DCFC34"
      },
      "package": "com.joaog.wayoftheweights",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite entrar no app com o reconhecimento facial."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite escolher fotos para a ficha de treino e para o seu perfil.",
          "cameraPermission": "Permite fotografar a ficha de treino e o seu perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d22ef134-e916-4516-9632-7f5db9e8f744"
      }
    }
  }
}
